{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "rm -rf .next .open-next .opennext .worker-next && opennextjs-cloudflare build",
    "build:next": "node scripts/next-build-filter.mjs",
    "start": "next start",
    "deploy": "npm run build && opennextjs-cloudflare deploy",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "migrate": "tsx scripts/migrate-content-to-d1.ts",
    "postinstall": "node -e \"if (!process.env.CI) process.exit(1)\" || wrangler types"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@number-flow/react": "^0.6.0",
    "@opennextjs/cloudflare": "^1.20.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "clsx": "^2.1.1",
    "jose": "^5.10.0",
    "maplibre-gl": "^5.7.0",
    "next": "^16.2.9",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@cloudflare/workers-types": "^5.20260717.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "^16.2.10",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^7",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  }
}
